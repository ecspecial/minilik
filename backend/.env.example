# LOG_LEVEL=debug — показывать debug-логи Nest и фрагменты ответов ИИ (см. LOG_VERBOSE_AI)
# LOG_VERBOSE_AI=true — первые ~400 символов текста/JSON от модели в логах
OPENAI_API_KEY=
# Чат / vision / JSON: gpt-5.4 | gpt-5.4-mini | gpt-5.4-nano
OPENAI_MODEL=gpt-5.4
# Картинки: gpt-image-1.5 | gpt-image-1-mini | снимок gpt-image-1.5-2025-12-16 — если пусто, только текстовое ТЗ
# Шаг 8 пайплайна собирает finalPackage на бэкенде без LLM; картинка остаётся в pipeline.generatedImageUrl / tabs.overview.
OPENAI_IMAGE_MODEL=gpt-image-1.5

PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Куда писать JSON сессий (полные данные + data URL фото). По умолчанию: ./data/sessions от cwd бэкенда.
# В Docker без тома и без mkdir в образе возможен fallback на /tmp/minilik-sessions (данные пропадут при удалении контейнера).
# Пример тома: SESSIONS_DATA_DIR=/var/minilik/sessions
SESSIONS_DATA_DIR=/var/minilik/sessions

JWT_SECRET=change-me-in-production
# Две учётные записи (логин + пароль). Значений по умолчанию нет.
AUTH_LOGIN_USER_1=
AUTH_LOGIN_PASS_1=
AUTH_LOGIN_USER_2=
AUTH_LOGIN_PASS_2=
